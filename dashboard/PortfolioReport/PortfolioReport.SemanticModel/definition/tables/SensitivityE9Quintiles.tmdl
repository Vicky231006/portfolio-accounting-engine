table SensitivityE9Quintiles
	lineageTag: 10000000-1000-4000-8000-00000000000c

	measure 'Median XIRR-TWR Difference (bp)' = SELECTEDVALUE(SensitivityE9Quintiles[median_xirr_minus_twr_bp])
		formatString: +0.00;-0.00;0.00

	measure 'Quintile Observations' = SUM(SensitivityE9Quintiles[observations])
		formatString: 0

	column band
		dataType: string
		summarizeBy: none
		sourceColumn: band
		sortByColumn: band_order

	column band_order
		dataType: int64
		summarizeBy: none
		sourceColumn: band_order

	column band_label
		dataType: string
		summarizeBy: none
		sourceColumn: band_label
		sortByColumn: band_order

	column observations
		dataType: int64
		summarizeBy: none
		sourceColumn: observations

	column min_drawdown_bp
		dataType: decimal
		summarizeBy: none
		sourceColumn: min_drawdown_bp
		formatString: 0.00

	column max_drawdown_bp
		dataType: decimal
		summarizeBy: none
		sourceColumn: max_drawdown_bp
		formatString: 0.00

	column median_drawdown_bp
		dataType: decimal
		summarizeBy: none
		sourceColumn: median_drawdown_bp
		formatString: 0.00

	column median_xirr_minus_twr_bp
		dataType: decimal
		summarizeBy: none
		sourceColumn: median_xirr_minus_twr_bp
		formatString: +0.00;-0.00;0.00

	column median_abs_xirr_minus_twr_bp
		dataType: decimal
		summarizeBy: none
		sourceColumn: median_abs_xirr_minus_twr_bp
		formatString: 0.00

	column p95_abs_xirr_minus_twr_bp
		dataType: decimal
		summarizeBy: none
		sourceColumn: p95_abs_xirr_minus_twr_bp
		formatString: 0.00

	partition SensitivityE9Quintiles = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database("localhost:5434", "bitemporal_ledger"),
					Data = Source{[Schema="marts", Item="sensitivity_e9_quintiles"]}[Data]
				in
					Data
