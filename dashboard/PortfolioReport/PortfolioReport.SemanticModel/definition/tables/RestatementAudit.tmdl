table RestatementAudit
	lineageTag: 10000000-1000-4000-8000-000000000003

	measure OriginalTransactions = COUNTROWS(FILTER(RestatementAudit, RestatementAudit[revision_no] = 1))

	measure AppliedCorrections = COUNTROWS(FILTER(RestatementAudit, RestatementAudit[revision_no] > 1))

	measure VoidedRevisions = COUNTROWS(FILTER(RestatementAudit, RestatementAudit[revision_status] = "VOIDED"))

	column txn_group_id
		dataType: string
		summarizeBy: none
		sourceColumn: txn_group_id

	column revision_no
		dataType: int64
		summarizeBy: none
		sourceColumn: revision_no

	column revision_kind
		dataType: string
		summarizeBy: none
		sourceColumn: revision_kind

	column revision_status
		dataType: string
		summarizeBy: none
		sourceColumn: revision_status

	column revision_txn_type
		dataType: string
		summarizeBy: none
		sourceColumn: revision_txn_type

	column reason_code
		dataType: string
		summarizeBy: none
		sourceColumn: reason_code

	column effective_date
		dataType: dateTime
		summarizeBy: none
		sourceColumn: effective_date

	column scheme_code
		dataType: string
		summarizeBy: none
		sourceColumn: scheme_code

	partition RestatementAudit = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database("localhost:5434", "bitemporal_ledger"),
					correction_audit = Source{[Schema="marts", Item="correction_audit"]}[Data]
				in
					correction_audit
