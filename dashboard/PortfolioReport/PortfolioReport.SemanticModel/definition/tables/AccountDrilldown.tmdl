table AccountDrilldown

	lineageTag: 10000000-1000-4000-8000-000000000002



	measure TransactionCount = COUNTROWS(AccountDrilldown)
		formatString: 0

	measure 'Transaction Count' = [TransactionCount]

		formatString: 0



	column account_id

		dataType: int64

		summarizeBy: none

		sourceColumn: account_id



	column txn_group_id

		dataType: string

		summarizeBy: none

		sourceColumn: txn_group_id



	column txn_type

		dataType: string

		summarizeBy: none

		sourceColumn: txn_type



	column instruction_date

		dataType: dateTime

		summarizeBy: none

		sourceColumn: instruction_date



	column effective_date

		dataType: dateTime

		summarizeBy: none

		sourceColumn: effective_date



	column allotment_date

		dataType: dateTime

		summarizeBy: none

		sourceColumn: allotment_date



	column posting_sequence

		dataType: int64

		summarizeBy: none

		sourceColumn: posting_sequence



	column scheme_code

		dataType: string

		summarizeBy: none

		sourceColumn: scheme_code



	column source_scheme_code

		dataType: string

		summarizeBy: none

		sourceColumn: source_scheme_code



	column target_scheme_code

		dataType: string

		summarizeBy: none

		sourceColumn: target_scheme_code



	column amount_instructed

		dataType: decimal

		summarizeBy: none

		sourceColumn: amount_instructed

		formatString: "₹"#,0.00



	column units_instructed

		dataType: decimal

		summarizeBy: none

		sourceColumn: units_instructed



	column recorded_at

		dataType: dateTime

		summarizeBy: none

		sourceColumn: recorded_at



	column is_voided

		dataType: boolean

		summarizeBy: none

		sourceColumn: is_voided



	partition AccountDrilldown = m

		mode: import

		source =

				let

					Source = PostgreSQL.Database("localhost:5434", "bitemporal_ledger"),

					account_drilldown = Source{[Schema="marts", Item="account_drilldown"]}[Data]

				in

					account_drilldown

