table ReportSnapshots

	lineageTag: 10000000-1000-4000-8000-000000000009



	measure SnapshotCount = COUNTROWS(ReportSnapshots)
		formatString: 0

	measure 'Snapshot Count' = [SnapshotCount]

		formatString: 0



	column report_snapshot_id

		dataType: int64

		summarizeBy: none

		sourceColumn: report_snapshot_id



	column account_id

		dataType: int64

		summarizeBy: none

		sourceColumn: account_id



	column period_start

		dataType: dateTime

		summarizeBy: none

		sourceColumn: period_start



	column period_end

		dataType: dateTime

		summarizeBy: none

		sourceColumn: period_end



	column known_as_of

		dataType: dateTime

		summarizeBy: none

		sourceColumn: known_as_of



	column total_value

		dataType: decimal

		summarizeBy: none

		sourceColumn: total_value

		formatString: "₹"#,0.00



	column cash

		dataType: decimal

		summarizeBy: none

		sourceColumn: cash

		formatString: "₹"#,0.00



	column twr

		dataType: decimal

		summarizeBy: none

		sourceColumn: twr

		formatString: 0.000000%;-0.000000%;0.000000%



	column modified_dietz

		dataType: decimal

		summarizeBy: none

		sourceColumn: modified_dietz



	column xirr_rate

		dataType: decimal

		summarizeBy: none

		sourceColumn: xirr_rate

		formatString: 0.000000%;-0.000000%;0.000000%



	column payload_sha256

		dataType: string

		summarizeBy: none

		sourceColumn: payload_sha256



	partition ReportSnapshots = m

		mode: import

		source =

				let

					Source = PostgreSQL.Database("localhost:5434", "bitemporal_ledger"),

					report_snapshots = Source{[Schema="marts", Item="report_snapshots"]}[Data]

				in

					report_snapshots

