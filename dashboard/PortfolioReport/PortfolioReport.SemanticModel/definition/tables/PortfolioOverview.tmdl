table PortfolioOverview

	lineageTag: 10000000-1000-4000-8000-000000000001



	measure SyntheticAccountCount = COUNTROWS(PortfolioOverview)



	measure TotalTransactions = SUM(PortfolioOverview[transaction_count])



	column account_id

		dataType: int64

		summarizeBy: none

		sourceColumn: account_id



	column synthetic_ref

		dataType: string

		summarizeBy: none

		sourceColumn: synthetic_ref



	column display_name

		dataType: string

		summarizeBy: none

		sourceColumn: display_name



	column account_status

		dataType: string

		summarizeBy: none

		sourceColumn: account_status



	column currency

		dataType: string

		summarizeBy: none

		sourceColumn: currency



	column transaction_count

		dataType: int64

		summarizeBy: sum

		sourceColumn: transaction_count



	partition PortfolioOverview = m

		mode: import

		source =

				let

					Source = PostgreSQL.Database("localhost:5434", "bitemporal_ledger"),

					portfolio_overview = Source{[Schema="marts", Item="portfolio_overview"]}[Data]

				in

					portfolio_overview

