table PerformanceSummary
	lineageTag: 10000000-1000-4000-8000-000000000005

	measure AvgTWR = AVERAGE(PerformanceSummary[twr])

	measure AvgXIRR = AVERAGE(PerformanceSummary[xirr_rate])

	column account_id
		dataType: int64
		summarizeBy: none
		sourceColumn: account_id

	column period_start
		dataType: dateTime
		summarizeBy: none
		sourceColumn: period_start

	column period_end
		dataType: dateTime
		summarizeBy: none
		sourceColumn: period_end

	column total_value
		dataType: decimal
		summarizeBy: sum
		sourceColumn: total_value

	column cash
		dataType: decimal
		summarizeBy: sum
		sourceColumn: cash

	column twr
		dataType: decimal
		summarizeBy: sum
		sourceColumn: twr

	column xirr_rate
		dataType: decimal
		summarizeBy: sum
		sourceColumn: xirr_rate

	partition PerformanceSummary = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database("localhost:5434", "bitemporal_ledger"),
					performance_summary = Source{[Schema="marts", Item="performance_summary"]}[Data]
				in
					performance_summary
