table CashFlows
	lineageTag: 10000000-1000-4000-8000-000000000006

	measure ExternalFlows = SUM(CashFlows[external_amount])

	column account_id
		dataType: int64
		summarizeBy: none
		sourceColumn: account_id

	column effective_date
		dataType: dateTime
		summarizeBy: none
		sourceColumn: effective_date

	column txn_type
		dataType: string
		summarizeBy: none
		sourceColumn: txn_type

	column external_amount
		dataType: decimal
		summarizeBy: sum
		sourceColumn: external_amount

	partition CashFlows = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database("localhost:5434", "bitemporal_ledger"),
					cash_flows = Source{[Schema="marts", Item="cash_flows"]}[Data]
				in
					cash_flows
