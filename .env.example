# bitemporal-ledger local configuration (placeholders only)
# Copy to .env and set real local values. Never commit .env.

# PostgreSQL (local-only binding in docker-compose.yml: 127.0.0.1:5434)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<set-a-non-default-local-password>
POSTGRES_DB=bitemporal_ledger
DATABASE_URL=postgresql://postgres:<set-a-non-default-local-password>@127.0.0.1:5434/bitemporal_ledger

# FundLens repository root (read-only). scripts/reproduce.py appends data/raw/amfi.
FUNDLENS_RAW_DIR=/path/to/fundlens

# Simulated knowledge-clock seed (generator-controlled)
SIMULATED_CLOCK_SEED=20261109

