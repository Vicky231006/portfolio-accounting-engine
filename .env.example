# bitemporal-ledger local configuration
# Copy to .env and adjust. Never commit .env.

# PostgreSQL connection (Docker Compose service: bitemporal-ledger-pg on host port 5434)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5434/bitemporal_ledger

# FundLens verified raw-file fallback root (read-only consumption of AMFI NAV gzip files)
FUNDLENS_RAW_DIR=/path/to/fundlens/raw_navs

# Simulated knowledge-clock seed (generator-controlled)
SIMULATED_CLOCK_SEED=20261109
